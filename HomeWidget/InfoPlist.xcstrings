    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لعرض تذكيراتك في أداة الشاشة الرئيسية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um deine Erinnerungen im Widget auf dem Home-Bildschirm anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show your reminders in the Home Screen widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para mostrar tus recordatorios en el widget de la pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet d’afficher vos rappels dans le widget de l’écran d’accueil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk menampilkan pengingat Anda di widget Layar Utama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a mostrare i tuoi promemoria nel widget della schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面のウィジェットにリマインダーを表示するために使います"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 위젯에 미리 알림을 표시하는 데 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt om je herinneringen in de widget op het beginscherm te tonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para mostrar seus lembretes no widget da Tela de Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы показывать напоминания в виджете на экране «Домой»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för att visa dina påminnelser i widgeten på hemskärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anımsatıcılarınızı ana ekran widget'ında göstermek için kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在主屏幕小组件中显示你的提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來在主畫面小工具中顯示你的提醒事項。"
          }
        }
      }
    }
  },
  "version": "1.0"
