        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: 전송됨(일반 전송, 워치 페이스에 없음)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: verstuurd (gewone overdracht, niet op wijzerplaat)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
