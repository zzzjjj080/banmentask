    "接続OK。変更は数秒で文字盤に反映されます": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل. تصل التغييرات إلى واجهة الساعة خلال ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden. Änderungen sind in Sekunden auf dem Zifferblatt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected. Changes reach the watch face in seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. Los cambios llegan a la esfera en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté. Les modifications arrivent sur le cadran en quelques secondes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung. Perubahan sampai di tampilan jam dalam hitungan detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso. Le modifiche arrivano sul quadrante in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続OK。変更は数秒で文字盤に反映されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨. 변경 사항이 몇 초 안에 워치 페이스에 반영됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden. Wijzigingen staan binnen seconden op de wijzerplaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. As alterações chegam ao mostrador em segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено. Изменения появятся на циферблате за секунды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluten. Ändringar når urtavlan inom några sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlandı. Değişiklikler saniyeler içinde kadrana ulaşır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接。更改会在几秒内显示在表盘上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線。變更會在幾秒內顯示在錶面上。"
          }
        }
      }
    },
