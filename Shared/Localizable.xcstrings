    "%@ %@: WCSession 未接続（5秒待っても接続できず）": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession غير متصل (تعذّر الاتصال بعد 5 ثوانٍ)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession nicht verbunden (nach 5 s keine Verbindung)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession not connected (no connection after 5 s)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession sin conexión (nada tras 5 s)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ : WCSession non connectée (rien après 5 s)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession tidak terhubung (tak tersambung setelah 5 dtk)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession non connessa (nessuna connessione dopo 5 s)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession 未接続（5秒待っても接続できず）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession 연결 안 됨(5초 동안 연결되지 않음)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession niet verbonden (geen verbinding na 5 s)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession sem conexão (nada após 5 s)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession не подключен (нет связи через 5 с)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession inte ansluten (ingen anslutning efter 5 s)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: WCSession bağlı değil (5 sn sonra da bağlanamadı)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：WCSession 未连接（等待 5 秒后仍无法连接）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：WCSession 未連線（等待 5 秒仍無法連線）"
          }
        }
      }
    },
    "%@ %@: Watch に直接返答（転送枠は消費しない）": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: تم الرد على Watch مباشرةً (دون استخدام عمليات النقل)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Direkt an Watch geantwortet (ohne Übertragung)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Replied to Watch directly (no transfer used)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Respuesta directa al Watch (sin gastar envíos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ : réponse directe à la Watch (sans transfert)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Membalas langsung ke Watch (tanpa kuota transfer)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: risposta diretta a Watch (nessun trasferimento usato)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Watch に直接返答（転送枠は消費しない）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Watch에 직접 응답함(전송 횟수 사용 안 함)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: direct geantwoord aan Watch (geen overdracht gebruikt)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: resposta direta ao Watch (sem usar transferências)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: ответ напрямую на Watch (без передачи)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Svarade Watch direkt (ingen överföring användes)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Watch'a doğrudan yanıt verildi (aktarım hakkı kullanılmadı)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：已直接回复 Watch（未占用传输次数）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：已直接回覆 Watch（未使用傳輸次數）"
          }
        }
      }
    },
