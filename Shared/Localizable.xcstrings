      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول من الإعدادات ← الخصوصية والأمن ← التقويمات لعرض الأحداث"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff unter Einstellungen → Datenschutz & Sicherheit → Kalender, um Termine anzuzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access in Settings → Privacy → Calendars to show events"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso en Ajustes → Privacidad y seguridad → Calendarios para ver eventos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès dans Réglages → Confidentialité et sécurité → Calendriers pour afficher les évènements"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses di Pengaturan → Privasi & Keamanan → Kalender untuk menampilkan acara"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso in Impostazioni → Privacy e sicurezza → Calendari per mostrare gli eventi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → プライバシー → カレンダー で許可すると予定を出せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 개인정보 보호 및 보안 → 캘린더에서 허용하면 일정을 표시할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang via Instellingen → Privacy en beveiliging → Agenda's om activiteiten te tonen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso em Ajustes → Privacidade e Segurança → Calendários para mostrar eventos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ в Настройках → Конфиденциальность и безопасность → Календари, чтобы видеть события"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge åtkomst i Inställningar → Integritet och säkerhet → Kalendrar för att visa händelser"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlikleri göstermek için Ayarlar → Gizlilik ve Güvenlik → Takvimler'de erişime izin verin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”→“隐私与安全性”→“日历”中允许访问后即可显示日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」→「隱私權與安全性」→「行事曆」中允許取用後即可顯示行程"
          }
        }
      }
    },
    "設定 → プライバシー → リマインダー で許可してください": {
      "extractionState": "manual",
