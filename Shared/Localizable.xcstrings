    "文字盤を裏で即時更新できる1日の回数。上位2件が変わった時だけ使う。0になっても文字盤をタップすれば反映される": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد التحديثات الفورية في الخلفية المتبقية اليوم. تُستخدم فقط عند تغيّر العناصر الأولى. عند الوصول إلى 0، اضغط على واجهة الساعة للتحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbleibende Sofort-Updates im Hintergrund für heute. Werden nur genutzt, wenn sich deine obersten Einträge ändern. Bei 0 einfach aufs Zifferblatt tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instant background updates left today. Used only when your top items change. At 0, just tap the watch face to refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones instantáneas en segundo plano que quedan hoy. Solo se usan cuando cambian tus primeros elementos. Si llegan a 0, toca la esfera para actualizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour instantanées en arrière-plan restantes aujourd’hui. Utilisées seulement quand vos premiers éléments changent. À 0, touchez simplement le cadran pour l’actualiser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa pembaruan instan di latar belakang hari ini. Hanya dipakai saat item teratas berubah. Jika 0, cukup ketuk tampilan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti istantanei in background rimasti per oggi. Usati solo quando cambiano i primi elementi. A 0, tocca il quadrante per aggiornarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤を裏で即時更新できる1日の回数。上位2件が変わった時だけ使う。0になっても文字盤をタップすれば反映される"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 남은 백그라운드 즉시 업데이트 횟수입니다. 상위 항목이 바뀔 때만 사용됩니다. 0이 되어도 워치 페이스를 탭하면 반영됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Directe updates op de achtergrond die vandaag nog over zijn. Alleen gebruikt als je bovenste items veranderen. Bij 0 tik je gewoon op de wijzerplaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações instantâneas em segundo plano restantes hoje. Usadas só quando seus primeiros itens mudam. Se chegar a 0, basta tocar no mostrador para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось мгновенных фоновых обновлений на сегодня. Тратятся, только когда меняются верхние пункты. При 0 просто коснитесь циферблата."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkta uppdateringar i bakgrunden som finns kvar i dag. Används bara när de översta objekten ändras. Vid 0 trycker du bara på urtavlan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kalan anlık arka plan güncellemeleri. Yalnızca en üstteki öğeler değiştiğinde kullanılır. 0 olduğunda yenilemek için kadrana dokunmanız yeterli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
