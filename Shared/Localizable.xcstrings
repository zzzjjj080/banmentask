    "%@ %@: 送信済み（文字盤経由・残り %lld 回/日）": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: تم الإرسال (عبر واجهة الساعة، متبقٍّ %lld اليوم)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Gesendet (übers Zifferblatt, heute noch %lld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Sent (via watch face, %lld left today)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Enviado (vía esfera, quedan %lld hoy)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ : envoyé (via le cadran, encore %lld aujourd’hui)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Terkirim (lewat tampilan jam, sisa %lld hari ini)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: inviato (tramite quadrante, ancora %lld oggi)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: 送信済み（文字盤経由・残り %lld 回/日）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: 전송됨(워치 페이스 경유, 오늘 %lld회 남음)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: verstuurd (via wijzerplaat, nog %lld over vandaag)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: enviado (pelo mostrador, restam %lld hoje)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: отправлено (через циферблат, осталось сегодня: %lld)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Skickat (via urtavlan, %lld kvar i dag)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Gönderildi (saat kadranı üzerinden, bugün %lld kaldı)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：已发送（经由表盘，今日剩余 %lld 次）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：已傳送（經由錶面，今天還剩 %lld 次）"
          }
        }
      }
    },
    "%@ %@: 送信済み（通常転送・文字盤に未配置）": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: تم الإرسال (نقل عادي، غير مضاف إلى واجهة الساعة)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Gesendet (normal, nicht auf dem Zifferblatt)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Sent (regular transfer, not on watch face)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Enviado (envío normal, no está en la esfera)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ : envoyé (transfert normal, absent du cadran)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: Terkirim (transfer biasa, belum di tampilan jam)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: inviato (trasferimento normale, non sul quadrante)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: 送信済み（通常転送・文字盤に未配置）"
