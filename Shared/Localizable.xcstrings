          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：已发送（常规传输，表盘上未添加）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@：已傳送（一般傳輸，錶面上未加入）"
          }
        }
