    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ TaskFace أحداث اليوم القادمة ليعرضها على واجهة ساعتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace liest die anstehenden Termine von heute, um sie auf dem Zifferblatt anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace reads today's upcoming events to show them on your watch face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace lee los próximos eventos de hoy para mostrarlos en la esfera del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace lit les prochains évènements du jour pour les afficher sur le cadran de votre montre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace membaca acara mendatang hari ini untuk menampilkannya di tampilan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace legge i prossimi eventi di oggi per mostrarli sul quadrante dell’orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のこれからの予定を文字盤に出すためにカレンダーを読み取ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace가 워치 페이스에 표시하기 위해 오늘 남은 일정을 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace leest de komende activiteiten van vandaag om ze op je wijzerplaat te tonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TaskFace lê os próximos eventos de hoje para mostrá-los no mostrador do relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace читает предстоящие события на сегодня, чтобы показывать их на циферблате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace läser dagens kommande händelser för att visa dem på urtavlan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace, bugünkü yaklaşan etkinlikleri saat kadranınızda göstermek için okur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表盘任务会读取今天接下来的日程，以便显示在手表表盘上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錶面任務會讀取今天接下來的行程，以便顯示在手錶錶面上。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ TaskFace تذكيراتك ليعرضها على واجهة ساعتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace liest deine Erinnerungen, um sie auf dem Zifferblatt anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace reads your reminders to show them on your watch face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace lee tus recordatorios para mostrarlos en la esfera del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace lit vos rappels pour les afficher sur le cadran de votre montre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace membaca pengingat Anda untuk menampilkannya di tampilan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace legge i tuoi promemoria per mostrarli sul quadrante dell’orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤に表示するタスクを読み取るためにリマインダーへアクセスします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace가 워치 페이스에 표시하기 위해 미리 알림을 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace leest je herinneringen om ze op je wijzerplaat te tonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TaskFace lê seus lembretes para mostrá-los no mostrador do relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace читает ваши напоминания, чтобы показывать их на циферблате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace läser dina påminnelser för att visa dem på urtavlan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskFace, anımsatıcılarınızı saat kadranınızda göstermek için okur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表盘任务会读取你的提醒事项，以便显示在手表表盘上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錶面任務會讀取你的提醒事項，以便顯示在手錶錶面上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
